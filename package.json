{
  "name": "dsh-plugin-sidebar-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Manage a persistent custom shortcut menu in the DSH left sidebar from Settings.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    ".gitignore"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "ligudian",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "sidebar",
    "menu"
  ]
}
